<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- We use rotation="-12" to simulate the italic leaning left (reverse italic) -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-12">
        
        <!-- Stem (on the right side for the reversed K) -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 68,26 h 16 v 56 h -16 z" />
            
        <!-- Top arm (pointing left-up) -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 68,56 L 46,26 H 28 L 68,68 Z" />
            
        <!-- Bottom arm (pointing left-down) -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 68,52 L 42,82 H 24 L 68,42 Z" />
            
    </group>
</vector>
